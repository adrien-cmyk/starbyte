SetOutputFilter DEFLATE
AddOutputFilterByType DEFLATE "application/javascript" "application/json" "application/manifest+json" "application/xml" "image/svg+xml" "text/css" "text/html" "text/javascript" "text/plain" "text/xml" "model/gltf-binary"

# SECTION BEGIN GIT PROTECTION
RedirectMatch 404 /\.git
# SECTION END GIT PROTECTION

RedirectMatch 404 /\.deploy-manifest

AddType model/gltf-binary .glb
AddType image/webp .webp
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
